@model ReservasListaViewModel

@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <div class="alert alert-danger" role="alert">@Model.Mensaje</div>
}
else if (Model.Reservas.Count == 0)
{
    <p class="text-secondary">No hay reservas para mostrar.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Hora</th>
                    <th scope="col">Mesa</th>
                    <th scope="col">Personas</th>
                    @if (Model.MostrarDatosCliente)
                    {
                        <th scope="col">Cliente</th>
                        <th scope="col">Teléfono</th>
                    }
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reserva in Model.Reservas)
                {
                    <tr>
                        <td>@reserva.FechaReserva.ToString("dd/MM/yyyy")</td>
                        <td>@reserva.HoraReserva.ToString("HH:mm")</td>
                        <td>Mesa @reserva.NumeroMesa</td>
                        <td>@reserva.CantidadPersonas</td>
                        @if (Model.MostrarDatosCliente)
                        {
                            <td>@reserva.NombreCliente</td>
                            <td>@(string.IsNullOrWhiteSpace(reserva.Telefono) ? "—" : reserva.Telefono)</td>
                        }
                        <td><span class="badge text-bg-secondary">@reserva.Estado</span></td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Reservas" asp-action="Detalle" asp-route-id="@reserva.Id">Detalles</a>
                                @if (Model.PuedeGestionar)
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="Reservas" asp-action="Editar" asp-route-id="@reserva.Id">Editar</a>
                                    @if (reserva.Estado == "PENDIENTE")
                                    {
                                        <form asp-controller="Reservas" asp-action="CambiarEstado" method="post">
                                            <input type="hidden" name="id" value="@reserva.Id" />
                                            <input type="hidden" name="estado" value="CONFIRMADA" />
                                            <button class="btn btn-sm btn-outline-success" type="submit">Confirmar</button>
                                        </form>
                                    }
                                    @if (reserva.Estado == "CONFIRMADA" && Model.PuedeMarcarAtendida)
                                    {
                                        <form asp-controller="Reservas" asp-action="Atender" method="post">
                                            <input type="hidden" name="id" value="@reserva.Id" />
                                            <button class="btn btn-sm btn-outline-success" type="submit">Marcar atendida</button>
                                        </form>
                                    }
                                    @if (reserva.Estado is "PENDIENTE" or "CONFIRMADA")
                                    {
                                        <form asp-controller="Reservas" asp-action="Cancelar" method="post"
                                              onsubmit="return confirm('¿Seguro que quieres cancelar esta reserva?');">
                                            <input type="hidden" name="id" value="@reserva.Id" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Cancelar</button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
