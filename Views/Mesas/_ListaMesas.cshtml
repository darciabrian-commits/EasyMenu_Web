@model MesasAdminViewModel

@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <div class="alert alert-danger" role="alert">@Model.Mensaje</div>
}
else if (Model.Mesas.Count == 0)
{
    <p class="text-secondary">Todavía no hay mesas registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Capacidad</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mesa in Model.Mesas)
                {
                    <tr>
                        <td>@mesa.Numero</td>
                        <td>@mesa.Capacidad personas</td>
                        <td>
                            @if (mesa.Activa)
                            {
                                <span class="badge text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-primary"
                                   data-detalle-mesa
                                   asp-controller="Mesas" asp-action="Detalle" asp-route-id="@mesa.Id">Detalles</a>
                                @if (Model.PuedeModificar)
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="Mesas" asp-action="Editar" asp-route-id="@mesa.Id">Editar</a>
                                    <form asp-controller="Mesas" asp-action="CambiarEstado" method="post"
                                          onsubmit="return confirm('¿Seguro que quieres @(mesa.Activa ? "desactivar" : "activar") esta mesa?');">
                                        <input type="hidden" name="id" value="@mesa.Id" />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                                            @(mesa.Activa ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
