@model ProductoFormularioViewModel
@{
    var esEdicion = Model.Id is not null;
    ViewData["Title"] = esEdicion ? "Editar producto" : "Nuevo producto";
    var categorias = new[] { "PLATILLO", "BEBIDA", "POSTRE" };
}

<div class="mb-4">
    <a asp-controller="Admin" asp-action="Productos" class="text-decoration-none">&larr; Productos</a>
    <h1 class="mt-2">@(esEdicion ? "Editar producto" : "Nuevo producto")</h1>
</div>

<form id="formulario-producto" asp-controller="Admin" asp-action="GuardarProducto" method="post" class="row g-3">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CategoriaOriginal" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-12">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" maxlength="100" autocomplete="off" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" maxlength="255" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Precio" class="form-label">Precio</label>
        <input asp-for="Precio" class="form-control" type="number" min="0.0000000000000000000000000001" step="any" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Categoria" class="form-label">Categoría</label>
        <select asp-for="Categoria" class="form-select">
            <option value="">Selecciona una categoría</option>
            @if (esEdicion && !categorias.Contains(Model.CategoriaOriginal, StringComparer.Ordinal))
            {
                <option value="@Model.CategoriaOriginal">@Model.CategoriaOriginal</option>
            }
            @foreach (var categoria in categorias)
            {
                <option value="@categoria">@categoria</option>
            }
        </select>
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary" type="submit">@(esEdicion ? "Guardar cambios" : "Crear producto")</button>
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Productos">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("formulario-producto").addEventListener("submit", evento => {
            if (!evento.target.reportValidity()) return;
            const boton = evento.target.querySelector("button[type='submit']");
            boton.disabled = true;
            boton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Guardando...';
        });
    </script>
}
