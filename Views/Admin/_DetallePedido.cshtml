@model EasyMenu.Web.Models.PedidoAdminViewModel

@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <div class="alert alert-danger" role="alert">@Model.Mensaje</div>
}
else
{
    <article class="card shadow-sm">
        <div class="card-body">
            <h2 class="h4 card-title">Detalle del pedido @Model.CodigoCorto</h2>
            @if (!string.IsNullOrWhiteSpace(Model.ClienteOMesa))
            {
                <p class="text-secondary">@Model.ClienteOMesa</p>
            }
            <p>Estado: <strong>@Model.Estado</strong></p>

            @if (Model.Productos.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Producto</th>
                                <th scope="col" class="text-end">Cantidad</th>
                                <th scope="col" class="text-end">Precio unitario</th>
                                <th scope="col" class="text-end">Subtotal</th>
                                <th scope="col">Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in Model.Productos)
                            {
                                <tr>
                                    <th scope="row">@producto.Nombre</th>
                                    <td class="text-end">@producto.Cantidad</td>
                                    <td class="text-end text-nowrap">@producto.PrecioUnitario.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                                    <td class="text-end text-nowrap">@producto.Subtotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                                    <td>@(producto.Notas ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-secondary">El pedido no tiene productos.</p>
            }

            <p class="text-end fs-5 mb-0">Total: <strong>@Model.Total.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong></p>

            @if (Model.Estado == "PENDIENTE_PAGO")
            {
                <form asp-controller="Admin" asp-action="CancelarPedido" method="post"
                      class="mt-3" data-cancelar-pedido data-pedido-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-outline-danger" type="submit">Cancelar</button>
                </form>
            }
        </div>
    </article>
}
