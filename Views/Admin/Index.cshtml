@{
    ViewData["Title"] = "Inicio de administración";
}

<h1 class="mb-4">Administración</h1>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <a class="card h-100 text-decoration-none shadow-sm" asp-controller="Admin" asp-action="Productos">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <h2 class="card-title">Productos</h2>
                <p class="card-text text-secondary mb-0">Consulta y administra los productos del menú.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a class="card h-100 text-decoration-none shadow-sm" asp-controller="Admin" asp-action="Pedidos">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <h2 class="card-title">Pedidos</h2>
                <p class="card-text text-secondary mb-0">Consulta y administra los pedidos.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a class="card h-100 text-decoration-none shadow-sm" asp-controller="Admin" asp-action="ResumenVentas">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <h2 class="card-title">Resumen de ventas</h2>
                <p class="card-text text-secondary mb-0">Consulta cobros, reembolsos y ventas netas por fecha.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a class="card h-100 text-decoration-none shadow-sm" asp-controller="Admin" asp-action="Personal">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <h2 class="card-title">Gestión de personal</h2>
                <p class="card-text text-secondary mb-0">Consulta, crea y desactiva usuarios del equipo.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a class="card h-100 text-decoration-none shadow-sm" asp-controller="Mesas" asp-action="Index">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <h2 class="card-title">Mesas</h2>
                <p class="card-text text-secondary mb-0">Consulta y administra las mesas del restaurante.</p>
            </div>
        </a>
    </div>
</div>
