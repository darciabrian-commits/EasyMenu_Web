@{
    ViewData["Title"] = "Inicio de administración";
}

<h1 class="mb-4">Administración</h1>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <a class="card h-100 text-decoration-none shadow-sm" asp-controller="Admin" asp-action="Productos">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <h2 class="card-title">Productos</h2>
                <p class="card-text text-secondary mb-0">Consulta y administra los productos del menú.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <div class="card h-100 bg-light text-secondary shadow-sm" aria-disabled="true">
            <div class="card-body d-flex flex-column justify-content-center p-4">
                <h2 class="card-title">Pedidos</h2>
                <p class="card-text mb-0">Próximamente</p>
            </div>
        </div>
    </div>
</div>
